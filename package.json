{
  "name": "opencode-loaded",
  "version": "0.1.0",
  "description": "OpenCode TUI plugin: shows which instruction files, skills, agents, commands, references, MCP servers and plugins are loaded for the current location and session.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "statusline",
    "agents",
    "skills",
    "instructions"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./tui": "./src/tui.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "dependencies": {
    "@opencode/plugin": "^2.3.2"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.4",
    "@opentui/solid": ">=0.8.4",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "^2.3.2",
    "@opentui/core": "^0.9.3",
    "@opentui/solid": "^0.9.3",
    "@types/node": "^24.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.9.0"
  },
  "author": "Paolo Lazzaroni",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/not-eexto/opencode-loaded.git"
  },
  "homepage": "https://github.com/not-eexto/opencode-loaded#readme",
